# ATK / VXE Gaming Mouse udev rules for userspace HID access without root/sudo
# Copy to /etc/udev/rules.d/71-open-atk.rules and reload:
#   sudo cp 71-open-atk.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger

# ATK / VXE Vendor IDs: 0x3554, 0x373b
# VXE R1 / R1 SE / R1 Pro / R1 Pro Max / Dragonfly / F1 / Mad R

KERNEL=="hidraw*", ATTRS{idVendor}=="3554", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3554", MODE="0666", TAG+="uaccess"

KERNEL=="hidraw*", ATTRS{idVendor}=="373b", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="373b", MODE="0666", TAG+="uaccess"

# USB Devices access
SUBSYSTEM=="usb", ATTRS{idVendor}=="3554", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="373b", MODE="0666", TAG+="uaccess"

